# Variables opcionales de PREDICCIÓN. Exportarlas antes de iniciar Uvicorn.
# Orígenes separados por comas para un frontend servido por separado.
FRONTEND_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
# Directorio opcional de pesos YOLO locales, fuera de frontend/.
# AULAPREDICT_YOLO_DIR=/ruta/a/pesos
# AULAPREDICT_DETECTOR_OBJETOS=off
# AULAPREDICT_MODELOS_FASE7=/ruta/a/modelos/fase7
# AULAPREDICT_MODELOS_FASE8=/ruta/a/modelos/fase8
# AULAPREDICT_FUSION_FASE10=/ruta/a/fusion.joblib
